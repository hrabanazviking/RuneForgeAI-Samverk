<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.samverk.webhook-delivery</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>-m</string>
		<string>samverk.webhook_delivery</string>
		<string>/Library/Application Support/Samverk/samverk.db</string>
		<string>/Library/Application Support/Samverk</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Library/Application Support/Samverk/logs/webhook-delivery.err.log</string>
	<key>StandardOutPath</key>
	<string>/Library/Application Support/Samverk/logs/webhook-delivery.out.log</string>
	<key>StartInterval</key>
	<integer>60</integer>
	<key>UserName</key>
	<string>_samverk</string>
	<key>WorkingDirectory</key>
	<string>/Library/Application Support/Samverk</string>
</dict>
</plist>
